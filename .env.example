# Copy to .env and fill in. In production, set the same names in the host's environment variables.

# Lekvya form keys: each delivers enquiries to its own inbox (lib/env.ts).
# Resort key (required): also the default for home, About, Contact and any brand left blank below.
LEKVYA_KEY_RESORT=
LEKVYA_KEY_EXPERIENCES=
LEKVYA_KEY_RESIDENCES=
LEKVYA_KEY_WELLNESS=
LEKVYA_KEY_MARE=

# Brand subdomains (lib/subdomains.ts): tavaro.in in production; leave unset to serve every page at its plain path.
NEXT_PUBLIC_ROOT_DOMAIN=
